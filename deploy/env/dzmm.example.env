# Optional hosted games; retain the existing production values when upgrading.
DZMM_MISTREALM_ENABLED=false
DZMM_CHESS_GAME_ID=
DZMM_CHESS_TOKEN_AUDIENCE=
DZMM_CHESS_ALLOW_UID=false
