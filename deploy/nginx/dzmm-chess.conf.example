# Example HTTPS virtual host for the public Gamefy chess API only.
# Replace host/certificate paths; keep the core service bound to 127.0.0.1.
server {
    listen 443 ssl;
    server_name chess.example.com;
    ssl_certificate /etc/letsencrypt/live/chess.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chess.example.com/privkey.pem;

    location ^~ /api/chess/ {
        proxy_pass http://127.0.0.1:18120;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location / { return 404; }
}
